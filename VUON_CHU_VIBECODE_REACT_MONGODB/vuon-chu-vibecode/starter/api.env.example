NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
# Đổi tên DB/host theo replica set hoặc Atlas thực tế; không chứa URI thật.
MONGODB_URI=mongodb://127.0.0.1:27017/vuon_chu_dev?replicaSet=rs0
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
SESSION_COOKIE_NAME=vuonchu.sid
SESSION_TTL_HOURS=12
PARENT_GATE_TTL_MINUTES=10
TRUST_PROXY=0
ALLOW_UNREVIEWED_DEMO_CONTENT=true
ENABLE_SERVER_RECORDINGS=false
ENABLE_CLOUD_SPEECH=false
ENABLE_BROWSER_SPEECH=false
ENABLE_OAUTH=false
ENABLE_QR_LOGIN=false
ENABLE_LUCKY_WHEEL=false
PRIVATE_MEDIA_DIR=./var/private-media
RECORDING_RETENTION_DAYS=7
MAX_RECORDING_BYTES=5242880
MAX_RECORDING_SECONDS=15
REPORT_TIMEZONE=Asia/Ho_Chi_Minh
# Chỉ điền local khi chạy provisioning, không commit vào git.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PIN=
DEMO_PARENT_PASSWORD=
DEMO_PARENT_PIN=
# Provider cloud tương lai; để trống ở MVP.
SPEECH_PROVIDER=
SPEECH_PROVIDER_API_KEY=
PRIVATE_STORAGE_BUCKET=
